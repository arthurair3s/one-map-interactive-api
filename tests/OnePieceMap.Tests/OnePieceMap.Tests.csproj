<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OnePieceMap.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Program.cs resolves the seed file relative to AppContext.BaseDirectory, which under
         `dotnet test` is this project's own output dir, not the API's — so it needs its own copy. -->
    <None Include="..\..\src\OnePieceMap.Infrastructure\Seed\seed-data.json"
          Link="OnePieceMap.Infrastructure\Seed\seed-data.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>